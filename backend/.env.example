# Supabase (Project Settings -> API)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Redis (Railway "Redis" plugin, or Upstash)
REDIS_URL=redis://localhost:6379

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_SONNET_MODEL=claude-sonnet-4-6
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5-20251001

# Slack (see slack-app/manifest.yaml + docs/MANUAL_SETUP.md)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Email fallback (Resend)
RESEND_API_KEY=
EMAIL_FROM=alerts@auditagent.dev

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=

# App
APP_BASE_URL=https://api.auditagent.dev
DASHBOARD_BASE_URL=https://app.auditagent.dev
CORS_ORIGINS=http://localhost:3000,https://app.auditagent.dev
APPROVAL_TIMEOUT_MINUTES=30
