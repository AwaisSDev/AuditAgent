# Supabase (Project Settings -> API)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Redis (Railway "Redis" plugin, or Upstash)
REDIS_URL=redis://localhost:6379

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_SONNET_MODEL=claude-sonnet-4-6
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5-20251001

# Slack (see slack-app/manifest.yaml + docs/MANUAL_SETUP.md)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Email fallback (Resend)
RESEND_API_KEY=
# Resend requires a verified sending domain -- auditagent.dev isn't owned,
# so there's no working default here yet. Use a domain you actually control.
EMAIL_FROM=alerts@example.com

# Stripe -- dormant, kept in case billing ever moves back to it. Whop below
# is the active provider.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=

# Whop (Settings -> Developer in the Whop dashboard; sandbox.whop.com for a
# test account). Create two plans named Starter and Pro, copy their ids
# below, then add a webhook at {APP_BASE_URL}/v1/billing/whop/webhook
# subscribed to membership.activated and membership.deactivated.
WHOP_API_BASE_URL=https://sandbox-api.whop.com/api/v1
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_PLAN_STARTER=
WHOP_PLAN_PRO=

# App -- these are the actual domains in use (HF Space backend, Vercel
# dashboard); auditagent.dev was never bought.
APP_BASE_URL=https://awais1290-auditagent.hf.space
DASHBOARD_BASE_URL=https://getauditagent.vercel.app
CORS_ORIGINS=http://localhost:3000,https://getauditagent.vercel.app
APPROVAL_TIMEOUT_MINUTES=30
