# Supabase (Project Settings -> API)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Redis (Railway "Redis" plugin, or Upstash)
REDIS_URL=redis://localhost:6379

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_SONNET_MODEL=claude-sonnet-4-6
ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5-20251001

# Slack (see slack-app/manifest.yaml + docs/MANUAL_SETUP.md)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Email fallback (Resend)
RESEND_API_KEY=
# Resend requires a verified sending domain. tracyn.online is owned now
# -- verify it in Resend, then use it here.
EMAIL_FROM=alerts@tracyn.online

# Whop (Settings -> Developer in the Whop dashboard; sandbox.whop.com for a
# test account). Create two plans named Starter and Pro, copy their ids
# below, then add a webhook at {APP_BASE_URL}/v1/billing/whop/webhook
# subscribed to membership.activated and membership.deactivated.
WHOP_API_BASE_URL=https://sandbox-api.whop.com/api/v1
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_PLAN_STARTER=
WHOP_PLAN_PRO=

# Error tracking (Sentry -- create a project at sentry.io, copy its DSN
# below). Leave unset to keep error tracking disabled (see app/main.py).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# App -- backend stays on the HF Space URL; tracyn.online is the
# dashboard's custom domain (attached in Vercel, DNS verified).
APP_BASE_URL=https://awais1290-auditagent.hf.space
DASHBOARD_BASE_URL=https://tracyn.online
CORS_ORIGINS=http://localhost:3000,https://tracyn.online,https://www.tracyn.online
APPROVAL_TIMEOUT_MINUTES=30
